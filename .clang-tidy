Checks: >
  -*,
  readability-redundant-declaration,
  readability-redundant-casting,
  readability-redundant-parentheses,
  misc-include-cleaner,
WarningsAsErrors: ""
HeaderFilterRegex: '^(src|include)/.*\.h$'
ExcludeHeaderFilterRegex: '^include/(hasm|include_asm)\.h$|^include/sys/'
FormatStyle: "file"
CheckOptions:
  # Require argument names to match exactly (instead of allowing a name to be a prefix/suffix of another).
  # '1' remains compatible with older clang-tidy versions that may read this file through an editor.
  - key: readability-inconsistent-declaration-parameter-name.Strict
    value: 1
  - key: readability-redundant-casting.IgnoreHeaders
    value: 'common\.h'
  - key: misc-include-cleaner.IgnoreHeaders
    value: 'common\.h;ultratypes\.h;include_asm\.h;h>'
