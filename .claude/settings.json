{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-unverified-commits.sh'"
          },
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-make-command.sh'"
          },
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-splat-split.sh'"
          },
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-ctx-file.sh'"
          },
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-temp-file.sh'"
          },
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-asm-edits.sh'"
          },
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-asm-processor-edits.sh'"
          },
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-permuter-timeout.sh'"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-ctx-file.sh'"
          },
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-temp-file.sh'"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-ctx-file.sh'"
          },
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-temp-file.sh'"
          },
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-asm-edits.sh'"
          },
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-asm-processor-edits.sh'"
          },
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-sha1-edits.sh'"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-ctx-file.sh'"
          },
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-temp-file.sh'"
          },
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-asm-edits.sh'"
          },
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-asm-processor-edits.sh'"
          },
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && .claude/hooks/block-sha1-edits.sh'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  },
  "autoMemoryEnabled": false
}
